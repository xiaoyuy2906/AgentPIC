{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LayoutBlock",
  "$defs": {
    "LayoutBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "cell": {
          "type": "string",
          "const": "mzi"
        },
        "primitives": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "delta_length_um": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        }
      },
      "required": [
        "name",
        "cell",
        "primitives",
        "delta_length_um"
      ],
      "additionalProperties": false
    }
  }
}
