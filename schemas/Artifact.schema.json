{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Artifact",
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "additionalProperties": false
    }
  }
}
