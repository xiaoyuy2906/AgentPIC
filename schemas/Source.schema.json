{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Source",
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "assumption",
            "literature",
            "characterization",
            "measurement",
            "foundry"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "calibrated": {
          "type": "boolean"
        },
        "evidence": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reference",
        "calibrated"
      ],
      "additionalProperties": false
    }
  }
}
