{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Placement",
  "$defs": {
    "Placement": {
      "type": "object",
      "properties": {
        "x_um": {
          "default": 0,
          "type": "number"
        },
        "y_um": {
          "default": 0,
          "type": "number"
        },
        "rotation_deg": {
          "default": 0,
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 90
            },
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 270
            }
          ]
        },
        "anchor": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "instance": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
                },
                "port": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                }
              },
              "required": [
                "instance",
                "port"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "port": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
