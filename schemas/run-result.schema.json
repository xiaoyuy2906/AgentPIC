{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_directory": {
      "title": "Artifact Directory",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "design_id": {
      "title": "Design Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "passed_with_limitations",
        "failed",
        "not_run"
      ],
      "title": "Verification Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "design_id",
    "artifact_directory",
    "status",
    "verification_status",
    "artifacts"
  ],
  "title": "RunResult",
  "type": "object"
}
