{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PDKComponent",
  "$defs": {
    "PDKComponent": {
      "type": "object",
      "properties": {
        "ports": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "domain": {
                "type": "string",
                "enum": [
                  "optical",
                  "electrical"
                ]
              },
              "position_um": {
                "default": null,
                "anyOf": [
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "orientation_deg": {
                "default": null,
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "domain"
            ],
            "additionalProperties": false
          }
        },
        "cell": {
          "type": "object",
          "properties": {
            "factory": {
              "type": "string",
              "minLength": 1
            },
            "cross_section": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "settings": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "actuator_cross_section": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "factory",
            "cross_section"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "validity": {
          "type": "object",
          "properties": {
            "wavelength_um": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "parameters": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "wavelength_um"
          ],
          "additionalProperties": false
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "ports",
        "cell",
        "model",
        "validity",
        "source"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "assumption",
            "literature",
            "characterization",
            "measurement",
            "foundry"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "calibrated": {
          "type": "boolean"
        },
        "evidence": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reference",
        "calibrated"
      ],
      "additionalProperties": false
    }
  }
}
