{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CascadeStage",
  "$defs": {
    "CascadeStage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "delta_length_um": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "delta_length_um"
      ],
      "additionalProperties": false
    },
    "PhaseControl": {
      "type": "object",
      "properties": {
        "phase_rad": {
          "type": "number",
          "minimum": -12.566370614359172,
          "maximum": 12.566370614359172
        },
        "active_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 20,
          "maximum": 200
        }
      },
      "required": [
        "phase_rad"
      ],
      "additionalProperties": false
    }
  }
}
