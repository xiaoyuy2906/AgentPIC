{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PhysicsConfiguration",
  "$defs": {
    "PhysicsConfiguration": {
      "type": "object",
      "properties": {
        "model_kind": {
          "type": "string"
        },
        "wavelength_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "polarization": {
          "type": "string",
          "enum": [
            "TE",
            "TM"
          ]
        },
        "layers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "thickness_um": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "refractive_index": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "thickness_um",
              "refractive_index"
            ],
            "additionalProperties": false
          }
        },
        "background_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grid_step_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "padding_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_points": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "model_kind",
        "wavelength_um",
        "polarization",
        "layers",
        "background_index",
        "grid_step_um",
        "padding_um",
        "max_points"
      ],
      "additionalProperties": false
    }
  }
}
