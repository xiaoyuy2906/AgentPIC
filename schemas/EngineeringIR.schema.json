{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EngineeringIR",
  "$defs": {
    "EngineeringIR": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "2.0",
          "type": "string",
          "const": "2.0"
        },
        "design_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "specification": {
          "$ref": "#/$defs/DesignSpec"
        },
        "technology": {
          "$ref": "#/$defs/PDK"
        },
        "netlist": {
          "$ref": "#/$defs/Circuit"
        },
        "hierarchy": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/CircuitHierarchy"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance_paths": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          }
        },
        "assembly": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/AssemblyPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "layout_resolved": {
          "default": false,
          "type": "boolean"
        },
        "length_source": {
          "default": "specification",
          "type": "string",
          "enum": [
            "specification",
            "layout"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "design_id",
        "specification",
        "technology",
        "netlist",
        "workflow",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "DesignSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/MZISpec"
        },
        {
          "$ref": "#/$defs/CascadeSpec"
        }
      ]
    },
    "MZISpec": {
      "type": "object",
      "properties": {
        "platform": {
          "default": "sin",
          "type": "string",
          "const": "sin"
        },
        "wavelength_nm": {
          "default": 1550,
          "type": "number",
          "minimum": 1500,
          "maximum": 1600
        },
        "outputs": {
          "default": [
            "netlist",
            "simulation",
            "gds",
            "verification"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "netlist",
              "simulation",
              "gds",
              "verification"
            ]
          }
        },
        "sweep_span_nm": {
          "default": 40,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "sweep_points": {
          "default": 201,
          "type": "integer",
          "minimum": 3,
          "maximum": 2001
        },
        "device": {
          "default": "mzi",
          "type": "string",
          "const": "mzi"
        },
        "delta_length_um": {
          "default": 10,
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PhaseControl": {
      "type": "object",
      "properties": {
        "phase_rad": {
          "type": "number",
          "minimum": -12.566370614359172,
          "maximum": 12.566370614359172
        },
        "active_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 20,
          "maximum": 200
        }
      },
      "required": [
        "phase_rad"
      ],
      "additionalProperties": false
    },
    "CascadeSpec": {
      "type": "object",
      "properties": {
        "platform": {
          "default": "sin",
          "type": "string",
          "const": "sin"
        },
        "wavelength_nm": {
          "default": 1550,
          "type": "number",
          "minimum": 1500,
          "maximum": 1600
        },
        "outputs": {
          "default": [
            "netlist",
            "simulation",
            "gds",
            "verification"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "netlist",
              "simulation",
              "gds",
              "verification"
            ]
          }
        },
        "sweep_span_nm": {
          "default": 40,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "sweep_points": {
          "default": 201,
          "type": "integer",
          "minimum": 3,
          "maximum": 2001
        },
        "device": {
          "type": "string",
          "const": "mzi_cascade"
        },
        "stages": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CascadeStage"
          }
        },
        "link_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 10,
          "maximum": 1000
        }
      },
      "required": [
        "device",
        "stages"
      ],
      "additionalProperties": false
    },
    "CascadeStage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "delta_length_um": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "delta_length_um"
      ],
      "additionalProperties": false
    },
    "PDK": {
      "type": "object",
      "properties": {
        "name": {
          "default": "sin_demo_v1",
          "type": "string",
          "const": "sin_demo_v1"
        },
        "foundry": {
          "default": null,
          "type": "null"
        },
        "calibrated": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "core_layer": {
          "default": [
            1,
            0
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "width_um": {
          "default": 1,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thickness_um": {
          "default": 0.4,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bend_radius_um": {
          "default": 50,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_width_um": {
          "default": 0.5,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_spacing_um": {
          "default": 0.5,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heater_layer": {
          "default": [
            2,
            0
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "heater_width_um": {
          "default": 2.5,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_wavelength_um": {
          "default": 1.55,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "effective_index": {
          "default": 1.8,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "group_index": {
          "default": 1.9,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loss_db_per_cm": {
          "default": 0,
          "type": "number",
          "const": 0
        },
        "model_version": {
          "default": "ideal_sin_v1",
          "type": "string",
          "const": "ideal_sin_v1"
        },
        "supported_components": {
          "default": [
            "ideal_coupler",
            "waveguide",
            "phase_shifter"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ideal_coupler",
              "waveguide",
              "phase_shifter"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "Circuit": {
      "type": "object",
      "properties": {
        "instances": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Connection"
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Endpoint"
          }
        }
      },
      "required": [
        "instances",
        "connections",
        "ports"
      ],
      "additionalProperties": false
    },
    "Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ideal_coupler",
            "waveguide",
            "phase_shifter"
          ]
        },
        "ports": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "length_um": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "coupling_ratio": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "ports"
      ],
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "domain": {
          "default": "optical",
          "type": "string",
          "enum": [
            "optical",
            "electrical"
          ]
        },
        "direction": {
          "default": "bidirectional",
          "type": "string",
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "Connection": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/Endpoint"
        },
        "b": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "additionalProperties": false
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "port": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "instance",
        "port"
      ],
      "additionalProperties": false
    },
    "CircuitHierarchy": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "type": "string",
          "const": "1.0"
        },
        "top": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "definitions": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CircuitDefinition"
          }
        }
      },
      "required": [
        "top",
        "definitions"
      ],
      "additionalProperties": false
    },
    "CircuitDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "primitives": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "modules": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleInstance"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Connection"
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Endpoint"
          }
        }
      },
      "required": [
        "name",
        "primitives",
        "modules",
        "connections",
        "ports"
      ],
      "additionalProperties": false
    },
    "ModuleInstance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "definition": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "name",
        "definition"
      ],
      "additionalProperties": false
    },
    "AssemblyPlan": {
      "type": "object",
      "properties": {
        "arrangement": {
          "type": "string",
          "const": "series"
        },
        "blocks": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayoutBlock"
          }
        },
        "link_length_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "a": {
                "$ref": "#/$defs/Endpoint"
              },
              "b": {
                "$ref": "#/$defs/Endpoint"
              }
            },
            "required": [
              "instance",
              "a",
              "b"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "arrangement",
        "blocks",
        "link_length_um",
        "links"
      ],
      "additionalProperties": false
    },
    "LayoutBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "cell": {
          "type": "string",
          "const": "mzi"
        },
        "primitives": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "delta_length_um": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        }
      },
      "required": [
        "name",
        "cell",
        "primitives",
        "delta_length_um"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "backend": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "depends_on",
        "backend"
      ],
      "additionalProperties": false
    }
  }
}
