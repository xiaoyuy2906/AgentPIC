{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EngineeringIR",
  "$defs": {
    "EngineeringIR": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "3.0",
          "type": "string",
          "const": "3.0"
        },
        "design_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "specification": {
          "$ref": "#/$defs/DesignSpec"
        },
        "technology": {
          "$ref": "#/$defs/PDK"
        },
        "netlist": {
          "$ref": "#/$defs/Circuit"
        },
        "hierarchy": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/CircuitHierarchy"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance_paths": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          }
        },
        "operating_point": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": -12.566370614359172,
                "maximum": 12.566370614359172
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "layout_resolved": {
          "default": false,
          "type": "boolean"
        },
        "length_source": {
          "default": "specification",
          "type": "string",
          "enum": [
            "specification",
            "layout"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "design_id",
        "specification",
        "technology",
        "netlist",
        "instance_paths",
        "workflow",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "DesignSpec": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "3.0",
          "type": "string",
          "const": "3.0"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "platform": {
          "default": "sin",
          "type": "string",
          "const": "sin"
        },
        "circuit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Circuit"
            },
            {
              "$ref": "#/$defs/CircuitHierarchy"
            }
          ]
        },
        "port_order": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "wavelength_nm": {
          "default": 1550,
          "type": "number",
          "minimum": 1500,
          "maximum": 1600
        },
        "sweep_span_nm": {
          "default": 40,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "sweep_points": {
          "default": 201,
          "type": "integer",
          "minimum": 3,
          "maximum": 10001
        },
        "outputs": {
          "default": [
            "netlist",
            "simulation",
            "gds",
            "verification"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "netlist",
              "simulation",
              "gds",
              "verification"
            ]
          }
        },
        "layout": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "tuning": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/TuningSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurements": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Measurement"
          }
        }
      },
      "required": [
        "name",
        "circuit",
        "port_order"
      ],
      "additionalProperties": false
    },
    "Circuit": {
      "type": "object",
      "properties": {
        "instances": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Connection"
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Endpoint"
          }
        }
      },
      "required": [
        "instances",
        "connections",
        "ports"
      ],
      "additionalProperties": false
    },
    "Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ideal_coupler",
            "waveguide",
            "phase_shifter"
          ]
        },
        "ports": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "length_um": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "coupling_ratio": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "ports"
      ],
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "domain": {
          "default": "optical",
          "type": "string",
          "enum": [
            "optical",
            "electrical"
          ]
        },
        "direction": {
          "default": "bidirectional",
          "type": "string",
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "PhaseControl": {
      "type": "object",
      "properties": {
        "phase_rad": {
          "type": "number",
          "minimum": -12.566370614359172,
          "maximum": 12.566370614359172
        },
        "active_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 20,
          "maximum": 200
        }
      },
      "required": [
        "phase_rad"
      ],
      "additionalProperties": false
    },
    "Connection": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/Endpoint"
        },
        "b": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "additionalProperties": false
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "port": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "instance",
        "port"
      ],
      "additionalProperties": false
    },
    "CircuitHierarchy": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "type": "string",
          "const": "1.0"
        },
        "top": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "definitions": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CircuitDefinition"
          }
        }
      },
      "required": [
        "top",
        "definitions"
      ],
      "additionalProperties": false
    },
    "CircuitDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "primitives": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "modules": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleInstance"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Connection"
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Endpoint"
          }
        }
      },
      "required": [
        "name",
        "primitives",
        "modules",
        "connections",
        "ports"
      ],
      "additionalProperties": false
    },
    "ModuleInstance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "definition": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "name",
        "definition"
      ],
      "additionalProperties": false
    },
    "LayoutPlan": {
      "type": "object",
      "properties": {
        "placements": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Placement"
          }
        },
        "routes": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Route"
          }
        },
        "constraints": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayoutConstraint"
          }
        }
      },
      "required": [
        "placements"
      ],
      "additionalProperties": false
    },
    "Placement": {
      "type": "object",
      "properties": {
        "x_um": {
          "default": 0,
          "type": "number"
        },
        "y_um": {
          "default": 0,
          "type": "number"
        },
        "rotation_deg": {
          "default": 0,
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 90
            },
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 270
            }
          ]
        },
        "anchor": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "instance": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
                },
                "port": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                }
              },
              "required": [
                "instance",
                "port"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "port": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Route": {
      "type": "object",
      "properties": {
        "steps": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteStep"
          }
        }
      },
      "additionalProperties": false
    },
    "RouteStep": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "dx_um": {
              "type": "number"
            }
          },
          "required": [
            "dx_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "dy_um": {
              "type": "number"
            }
          },
          "required": [
            "dy_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "x_um": {
              "type": "number"
            }
          },
          "required": [
            "x_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "y_um": {
              "type": "number"
            }
          },
          "required": [
            "y_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "x_from_end_um": {
              "type": "number"
            }
          },
          "required": [
            "x_from_end_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "y_from_end_um": {
              "type": "number"
            }
          },
          "required": [
            "y_from_end_um"
          ],
          "additionalProperties": false
        }
      ]
    },
    "LayoutConstraint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "length"
            },
            "instance": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
            },
            "value_um": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tolerance_um": {
              "default": 0.001,
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "instance",
            "value_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "length_difference"
            },
            "a": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
            },
            "b": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
            },
            "value_um": {
              "type": "number"
            },
            "tolerance_um": {
              "default": 0.002,
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "a",
            "b",
            "value_um"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TuningSpec": {
      "type": "object",
      "properties": {
        "targets": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "input_port": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "output_port": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "wavelength_nm": {
                "type": "number",
                "minimum": 1450,
                "maximum": 1650
              },
              "power": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "input_port",
              "output_port",
              "wavelength_nm",
              "power"
            ],
            "additionalProperties": false
          }
        },
        "variables": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instance_path": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                }
              },
              "min_phase_rad": {
                "type": "number",
                "minimum": -12.566370614359172,
                "maximum": 12.566370614359172
              },
              "max_phase_rad": {
                "type": "number",
                "minimum": -12.566370614359172,
                "maximum": 12.566370614359172
              }
            },
            "required": [
              "instance_path",
              "min_phase_rad",
              "max_phase_rad"
            ],
            "additionalProperties": false
          }
        },
        "power_tolerance": {
          "default": 0.000001,
          "type": "number",
          "minimum": 1e-9,
          "maximum": 0.001
        },
        "max_evaluations": {
          "default": 128,
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      },
      "required": [
        "targets",
        "variables"
      ],
      "additionalProperties": false
    },
    "Measurement": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "resonances"
        },
        "input_port": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "output_port": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "min_count": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "kind",
        "input_port",
        "output_port"
      ],
      "additionalProperties": false
    },
    "PDK": {
      "type": "object",
      "properties": {
        "name": {
          "default": "sin_demo_v1",
          "type": "string",
          "const": "sin_demo_v1"
        },
        "foundry": {
          "default": null,
          "type": "null"
        },
        "calibrated": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "core_layer": {
          "default": [
            1,
            0
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "width_um": {
          "default": 1,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thickness_um": {
          "default": 0.4,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bend_radius_um": {
          "default": 50,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_width_um": {
          "default": 0.5,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_spacing_um": {
          "default": 0.5,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heater_layer": {
          "default": [
            2,
            0
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "heater_width_um": {
          "default": 2.5,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_wavelength_um": {
          "default": 1.55,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "effective_index": {
          "default": 1.8,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "group_index": {
          "default": 1.9,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loss_db_per_cm": {
          "default": 0,
          "type": "number",
          "const": 0
        },
        "model_version": {
          "default": "ideal_sin_v1",
          "type": "string",
          "const": "ideal_sin_v1"
        },
        "supported_components": {
          "default": [
            "ideal_coupler",
            "waveguide",
            "phase_shifter"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ideal_coupler",
              "waveguide",
              "phase_shifter"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "backend": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "depends_on",
        "backend"
      ],
      "additionalProperties": false
    }
  }
}
