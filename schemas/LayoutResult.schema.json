{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LayoutResult",
  "$defs": {
    "LayoutResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "3.0"
        },
        "top_cell": {
          "type": "string"
        },
        "technology": {
          "type": "string"
        },
        "core_layer": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "lengths_um": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "centerlines_um": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/PhysicalPort"
            }
          }
        },
        "extracted_circuit": {
          "$ref": "#/$defs/Circuit"
        },
        "bend_radius_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "actuators": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ActuatorLayout"
          }
        }
      },
      "required": [
        "schema_version",
        "top_cell",
        "technology",
        "core_layer",
        "lengths_um",
        "centerlines_um",
        "ports",
        "extracted_circuit",
        "bend_radius_um"
      ],
      "additionalProperties": false
    },
    "PhysicalPort": {
      "type": "object",
      "properties": {
        "center_um": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "orientation_deg": {
          "type": "number"
        },
        "width_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "domain": {
          "default": "optical",
          "type": "string",
          "enum": [
            "optical",
            "electrical"
          ]
        }
      },
      "required": [
        "center_um",
        "orientation_deg",
        "width_um"
      ],
      "additionalProperties": false
    },
    "Circuit": {
      "type": "object",
      "properties": {
        "instances": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Connection"
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Endpoint"
          }
        }
      },
      "required": [
        "instances",
        "connections",
        "ports"
      ],
      "additionalProperties": false
    },
    "Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ideal_coupler",
            "waveguide",
            "phase_shifter"
          ]
        },
        "ports": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "length_um": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "coupling_ratio": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "ports"
      ],
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "domain": {
          "default": "optical",
          "type": "string",
          "enum": [
            "optical",
            "electrical"
          ]
        },
        "direction": {
          "default": "bidirectional",
          "type": "string",
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "PhaseControl": {
      "type": "object",
      "properties": {
        "phase_rad": {
          "type": "number",
          "minimum": -12.566370614359172,
          "maximum": 12.566370614359172
        },
        "active_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 20,
          "maximum": 200
        }
      },
      "required": [
        "phase_rad"
      ],
      "additionalProperties": false
    },
    "Connection": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/Endpoint"
        },
        "b": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "additionalProperties": false
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "port": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "instance",
        "port"
      ],
      "additionalProperties": false
    },
    "ActuatorLayout": {
      "type": "object",
      "properties": {
        "centerline_um": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "layer": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "width_um": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "centerline_um",
        "layer",
        "width_um"
      ],
      "additionalProperties": false
    }
  }
}
