{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/VerificationReport",
  "$defs": {
    "VerificationReport": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "3.0",
          "type": "string",
          "const": "3.0"
        },
        "design_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed_with_limitations",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckResult"
          }
        },
        "foundry_signoff": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "design_id",
        "status",
        "checks",
        "limitations"
      ],
      "additionalProperties": false
    },
    "CheckResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "status",
        "detail"
      ],
      "additionalProperties": false
    }
  }
}
