{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MZISpec",
  "$defs": {
    "MZISpec": {
      "type": "object",
      "properties": {
        "platform": {
          "default": "sin",
          "type": "string",
          "const": "sin"
        },
        "wavelength_nm": {
          "default": 1550,
          "type": "number",
          "minimum": 1500,
          "maximum": 1600
        },
        "outputs": {
          "default": [
            "netlist",
            "simulation",
            "gds",
            "verification"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "netlist",
              "simulation",
              "gds",
              "verification"
            ]
          }
        },
        "sweep_span_nm": {
          "default": 40,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "sweep_points": {
          "default": 201,
          "type": "integer",
          "minimum": 3,
          "maximum": 2001
        },
        "device": {
          "default": "mzi",
          "type": "string",
          "const": "mzi"
        },
        "delta_length_um": {
          "default": 10,
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PhaseControl": {
      "type": "object",
      "properties": {
        "phase_rad": {
          "type": "number",
          "minimum": -12.566370614359172,
          "maximum": 12.566370614359172
        },
        "active_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 20,
          "maximum": 200
        }
      },
      "required": [
        "phase_rad"
      ],
      "additionalProperties": false
    }
  }
}
