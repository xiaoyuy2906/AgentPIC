{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ExperimentEvidence",
  "$defs": {
    "ExperimentEvidence": {
      "type": "object",
      "properties": {
        "experiment": {
          "$ref": "#/$defs/Experiment"
        },
        "configuration_sha256": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstraintEvaluation"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "experiment",
        "configuration_sha256",
        "result",
        "checks",
        "error"
      ],
      "additionalProperties": false
    },
    "Experiment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configuration": {
          "$ref": "#/$defs/PhysicsConfiguration"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        }
      },
      "required": [
        "id",
        "operation",
        "purpose",
        "hypothesis_ids",
        "configuration",
        "criteria"
      ],
      "additionalProperties": false
    },
    "PhysicsConfiguration": {
      "type": "object",
      "properties": {
        "model_kind": {
          "type": "string"
        },
        "wavelength_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "polarization": {
          "type": "string",
          "enum": [
            "TE",
            "TM"
          ]
        },
        "layers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "thickness_um": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "refractive_index": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "thickness_um",
              "refractive_index"
            ],
            "additionalProperties": false
          }
        },
        "background_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grid_step_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "padding_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_points": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "model_kind",
        "wavelength_um",
        "polarization",
        "layers",
        "background_index",
        "grid_step_um",
        "padding_um",
        "max_points"
      ],
      "additionalProperties": false
    },
    "Criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "observable": {
          "type": "string"
        },
        "comparison": {
          "type": "string",
          "enum": [
            "lt",
            "lte",
            "gte",
            "range"
          ]
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "unit": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "observable",
        "comparison",
        "thresholds",
        "unit",
        "rationale"
      ],
      "additionalProperties": false
    },
    "PhysicalResult": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "effective_index": {
          "type": "number"
        },
        "beta_per_um": {
          "type": "number"
        },
        "units": {
          "type": "object",
          "properties": {
            "effective_index": {
              "type": "string",
              "const": "1"
            },
            "beta_per_um": {
              "type": "string",
              "const": "um^-1"
            },
            "coordinates": {
              "type": "string",
              "const": "um"
            },
            "field": {
              "type": "string",
              "const": "arbitrary_normalized"
            }
          },
          "required": [
            "effective_index",
            "beta_per_um",
            "coordinates",
            "field"
          ],
          "additionalProperties": false
        },
        "x_um": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "field_amplitude": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "grid_points": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "actual_grid_step_um": {
              "type": "number"
            },
            "relative_residual": {
              "type": "number"
            },
            "edge_amplitude_ratio": {
              "type": "number"
            },
            "elapsed_seconds": {
              "type": "number",
              "minimum": 0
            },
            "estimated_array_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "grid_points",
            "actual_grid_step_um",
            "relative_residual",
            "edge_amplitude_ratio",
            "elapsed_seconds",
            "estimated_array_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "backend",
        "method",
        "effective_index",
        "beta_per_um",
        "units",
        "x_um",
        "field_amplitude",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "ConstraintEvaluation": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_evaluated"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "status",
        "value",
        "evidence_ids",
        "detail"
      ],
      "additionalProperties": false
    }
  }
}
