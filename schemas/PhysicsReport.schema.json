{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PhysicsReport",
  "$defs": {
    "PhysicsReport": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "run_id": {
          "type": "string"
        },
        "goal_sha256": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "improved",
            "rejected",
            "inconclusive",
            "invalid",
            "unsupported"
          ]
        },
        "artifact_directory": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhysicsDiagnostic"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExperimentEvidence"
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hypothesis"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstraintEvaluation"
          }
        },
        "baseline_verified": {
          "type": "boolean"
        },
        "accepted_configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicsConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "development_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/DevelopmentRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "physical_principle",
                  "llm_proposal",
                  "numerical_evidence",
                  "deterministic_verification",
                  "engineering_judgment"
                ]
              },
              "statement": {
                "type": "string"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "statement",
              "evidence_ids"
            ],
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "resource_usage": {
          "type": "object",
          "properties": {
            "experiments_executed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "wall_seconds": {
              "type": "number"
            },
            "solver_seconds": {
              "type": "number"
            },
            "maximum_grid_points": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "peak_estimated_array_bytes": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "experiments_executed",
            "wall_seconds",
            "solver_seconds",
            "maximum_grid_points",
            "peak_estimated_array_bytes"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "foundry_signoff": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "goal_sha256",
        "status",
        "artifact_directory",
        "criteria",
        "diagnostics",
        "evidence",
        "hypotheses",
        "checks",
        "baseline_verified",
        "accepted_configuration",
        "development_request",
        "reasoning",
        "provenance",
        "resource_usage",
        "limitations",
        "foundry_signoff"
      ],
      "additionalProperties": false
    },
    "Criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "observable": {
          "type": "string"
        },
        "comparison": {
          "type": "string",
          "enum": [
            "lt",
            "lte",
            "gte",
            "range"
          ]
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "unit": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "observable",
        "comparison",
        "thresholds",
        "unit",
        "rationale"
      ],
      "additionalProperties": false
    },
    "PhysicsDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "possible_cause": {
          "type": "string"
        },
        "suggested_action": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "possible_cause",
        "suggested_action"
      ],
      "additionalProperties": false
    },
    "ExperimentEvidence": {
      "type": "object",
      "properties": {
        "experiment": {
          "$ref": "#/$defs/Experiment"
        },
        "configuration_sha256": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstraintEvaluation"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "experiment",
        "configuration_sha256",
        "result",
        "checks",
        "error"
      ],
      "additionalProperties": false
    },
    "Experiment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configuration": {
          "$ref": "#/$defs/PhysicsConfiguration"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        }
      },
      "required": [
        "id",
        "operation",
        "purpose",
        "hypothesis_ids",
        "configuration",
        "criteria"
      ],
      "additionalProperties": false
    },
    "PhysicsConfiguration": {
      "type": "object",
      "properties": {
        "model_kind": {
          "type": "string"
        },
        "wavelength_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "polarization": {
          "type": "string",
          "enum": [
            "TE",
            "TM"
          ]
        },
        "layers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "thickness_um": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "refractive_index": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "thickness_um",
              "refractive_index"
            ],
            "additionalProperties": false
          }
        },
        "background_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grid_step_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "padding_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_points": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "model_kind",
        "wavelength_um",
        "polarization",
        "layers",
        "background_index",
        "grid_step_um",
        "padding_um",
        "max_points"
      ],
      "additionalProperties": false
    },
    "PhysicalResult": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "effective_index": {
          "type": "number"
        },
        "beta_per_um": {
          "type": "number"
        },
        "units": {
          "type": "object",
          "properties": {
            "effective_index": {
              "type": "string",
              "const": "1"
            },
            "beta_per_um": {
              "type": "string",
              "const": "um^-1"
            },
            "coordinates": {
              "type": "string",
              "const": "um"
            },
            "field": {
              "type": "string",
              "const": "arbitrary_normalized"
            }
          },
          "required": [
            "effective_index",
            "beta_per_um",
            "coordinates",
            "field"
          ],
          "additionalProperties": false
        },
        "x_um": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "field_amplitude": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "grid_points": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "actual_grid_step_um": {
              "type": "number"
            },
            "relative_residual": {
              "type": "number"
            },
            "edge_amplitude_ratio": {
              "type": "number"
            },
            "elapsed_seconds": {
              "type": "number",
              "minimum": 0
            },
            "estimated_array_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "grid_points",
            "actual_grid_step_um",
            "relative_residual",
            "edge_amplitude_ratio",
            "elapsed_seconds",
            "estimated_array_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "backend",
        "method",
        "effective_index",
        "beta_per_um",
        "units",
        "x_um",
        "field_amplitude",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "ConstraintEvaluation": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_evaluated"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "status",
        "value",
        "evidence_ids",
        "detail"
      ],
      "additionalProperties": false
    },
    "Hypothesis": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "deterministic_physics",
            "external_llm"
          ]
        },
        "statement": {
          "type": "string"
        },
        "cause": {
          "type": "string",
          "enum": [
            "discretization_error",
            "boundary_truncation",
            "non_reproducibility",
            "reference_disagreement",
            "input_error"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "contradicted",
            "inconclusive"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "statement",
        "cause",
        "status",
        "evidence_ids",
        "explanation"
      ],
      "additionalProperties": false
    },
    "DevelopmentRequest": {
      "type": "object",
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "requires_implementation"
        },
        "technical_specification": {
          "type": "string"
        },
        "library_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "depends_on",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "promotion_gate": {
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "status",
        "technical_specification",
        "library_candidates",
        "tasks",
        "promotion_gate"
      ],
      "additionalProperties": false
    }
  }
}
