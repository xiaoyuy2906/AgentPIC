{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CascadeSpec",
  "$defs": {
    "CascadeSpec": {
      "type": "object",
      "properties": {
        "tuning": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/TuningSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "default": "sin",
          "type": "string",
          "const": "sin"
        },
        "wavelength_nm": {
          "default": 1550,
          "type": "number",
          "minimum": 1500,
          "maximum": 1600
        },
        "outputs": {
          "default": [
            "netlist",
            "simulation",
            "gds",
            "verification"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "netlist",
              "simulation",
              "gds",
              "verification"
            ]
          }
        },
        "sweep_span_nm": {
          "default": 40,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "sweep_points": {
          "default": 201,
          "type": "integer",
          "minimum": 3,
          "maximum": 2001
        },
        "device": {
          "type": "string",
          "const": "mzi_cascade"
        },
        "stages": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CascadeStage"
          }
        },
        "link_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 10,
          "maximum": 1000
        }
      },
      "required": [
        "device",
        "stages"
      ],
      "additionalProperties": false
    },
    "TuningSpec": {
      "type": "object",
      "properties": {
        "targets": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "input_port": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "output_port": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "wavelength_nm": {
                "type": "number",
                "minimum": 1450,
                "maximum": 1650
              },
              "power": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "input_port",
              "output_port",
              "wavelength_nm",
              "power"
            ],
            "additionalProperties": false
          }
        },
        "variables": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instance_path": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                }
              },
              "min_phase_rad": {
                "type": "number",
                "minimum": -12.566370614359172,
                "maximum": 12.566370614359172
              },
              "max_phase_rad": {
                "type": "number",
                "minimum": -12.566370614359172,
                "maximum": 12.566370614359172
              }
            },
            "required": [
              "instance_path",
              "min_phase_rad",
              "max_phase_rad"
            ],
            "additionalProperties": false
          }
        },
        "power_tolerance": {
          "default": 0.000001,
          "type": "number",
          "minimum": 1e-9,
          "maximum": 0.001
        },
        "max_evaluations": {
          "default": 128,
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      },
      "required": [
        "targets",
        "variables"
      ],
      "additionalProperties": false
    },
    "CascadeStage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "delta_length_um": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "delta_length_um"
      ],
      "additionalProperties": false
    },
    "PhaseControl": {
      "type": "object",
      "properties": {
        "phase_rad": {
          "type": "number",
          "minimum": -12.566370614359172,
          "maximum": 12.566370614359172
        },
        "active_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 20,
          "maximum": 200
        }
      },
      "required": [
        "phase_rad"
      ],
      "additionalProperties": false
    }
  }
}
