{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PDK",
  "$defs": {
    "PDK": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "foundry": {
          "type": [
            "string",
            "null"
          ]
        },
        "database_unit_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "rules": {
          "type": "object",
          "properties": {
            "minimum_width_um": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minimum_spacing_um": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bend_radius_um": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "minimum_width_um",
            "minimum_spacing_um",
            "bend_radius_um"
          ],
          "additionalProperties": false
        },
        "materials": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Material"
          }
        },
        "cross_sections": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/CrossSection"
          }
        },
        "components": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "ideal_coupler",
              "waveguide",
              "phase_shifter"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/PDKComponent"
          }
        }
      },
      "required": [
        "schema_version",
        "name",
        "description",
        "foundry",
        "database_unit_um",
        "layers",
        "rules",
        "materials",
        "cross_sections",
        "components"
      ],
      "additionalProperties": false
    },
    "Material": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "const": "sellmeier"
        },
        "terms": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "b": {
                "type": "number"
              },
              "c_um": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "b",
              "c_um"
            ],
            "additionalProperties": false
          }
        },
        "validity_wavelength_um": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "model",
        "terms",
        "validity_wavelength_um",
        "source"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "assumption",
            "literature",
            "characterization",
            "measurement",
            "foundry"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "calibrated": {
          "type": "boolean"
        },
        "evidence": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reference",
        "calibrated"
      ],
      "additionalProperties": false
    },
    "CrossSection": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "width_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thickness_um": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "core_material": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cladding_material": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/ModeModel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "layer",
        "width_um"
      ],
      "additionalProperties": false
    },
    "ModeModel": {
      "type": "object",
      "properties": {
        "reference_wavelength_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "effective_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "group_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loss_db_per_cm": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "reference_wavelength_um",
        "effective_index",
        "group_index",
        "loss_db_per_cm",
        "source"
      ],
      "additionalProperties": false
    },
    "PDKComponent": {
      "type": "object",
      "properties": {
        "ports": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "domain": {
                "type": "string",
                "enum": [
                  "optical",
                  "electrical"
                ]
              },
              "position_um": {
                "default": null,
                "anyOf": [
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "orientation_deg": {
                "default": null,
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "domain"
            ],
            "additionalProperties": false
          }
        },
        "cell": {
          "type": "object",
          "properties": {
            "factory": {
              "type": "string",
              "minLength": 1
            },
            "cross_section": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "settings": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "actuator_cross_section": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "factory",
            "cross_section"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "validity": {
          "type": "object",
          "properties": {
            "wavelength_um": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "parameters": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "wavelength_um"
          ],
          "additionalProperties": false
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "ports",
        "cell",
        "model",
        "validity",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
