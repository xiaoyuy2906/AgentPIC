{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CircuitHierarchy",
  "$defs": {
    "CircuitHierarchy": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "type": "string",
          "const": "1.0"
        },
        "top": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "definitions": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CircuitDefinition"
          }
        }
      },
      "required": [
        "top",
        "definitions"
      ],
      "additionalProperties": false
    },
    "CircuitDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "primitives": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "modules": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleInstance"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Connection"
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Endpoint"
          }
        }
      },
      "required": [
        "name",
        "primitives",
        "modules",
        "connections",
        "ports"
      ],
      "additionalProperties": false
    },
    "Component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ideal_coupler",
            "waveguide",
            "phase_shifter"
          ]
        },
        "ports": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "length_um": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "coupling_ratio": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "phase_control": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseControl"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "ports"
      ],
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "domain": {
          "default": "optical",
          "type": "string",
          "enum": [
            "optical",
            "electrical"
          ]
        },
        "direction": {
          "default": "bidirectional",
          "type": "string",
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "PhaseControl": {
      "type": "object",
      "properties": {
        "phase_rad": {
          "type": "number",
          "minimum": -12.566370614359172,
          "maximum": 12.566370614359172
        },
        "active_length_um": {
          "default": 100,
          "type": "number",
          "minimum": 20,
          "maximum": 200
        }
      },
      "required": [
        "phase_rad"
      ],
      "additionalProperties": false
    },
    "ModuleInstance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "definition": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "name",
        "definition"
      ],
      "additionalProperties": false
    },
    "Connection": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/Endpoint"
        },
        "b": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "additionalProperties": false
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "port": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "instance",
        "port"
      ],
      "additionalProperties": false
    }
  }
}
