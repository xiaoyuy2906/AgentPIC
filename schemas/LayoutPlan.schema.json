{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LayoutPlan",
  "$defs": {
    "LayoutPlan": {
      "type": "object",
      "properties": {
        "placements": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Placement"
          }
        },
        "routes": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Route"
          }
        },
        "constraints": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayoutConstraint"
          }
        }
      },
      "required": [
        "placements"
      ],
      "additionalProperties": false
    },
    "Placement": {
      "type": "object",
      "properties": {
        "x_um": {
          "default": 0,
          "type": "number"
        },
        "y_um": {
          "default": 0,
          "type": "number"
        },
        "rotation_deg": {
          "default": 0,
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 90
            },
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 270
            }
          ]
        },
        "anchor": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "instance": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
                },
                "port": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                }
              },
              "required": [
                "instance",
                "port"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "port": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Route": {
      "type": "object",
      "properties": {
        "steps": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteStep"
          }
        }
      },
      "additionalProperties": false
    },
    "RouteStep": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "dx_um": {
              "type": "number"
            }
          },
          "required": [
            "dx_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "dy_um": {
              "type": "number"
            }
          },
          "required": [
            "dy_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "x_um": {
              "type": "number"
            }
          },
          "required": [
            "x_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "y_um": {
              "type": "number"
            }
          },
          "required": [
            "y_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "x_from_end_um": {
              "type": "number"
            }
          },
          "required": [
            "x_from_end_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "y_from_end_um": {
              "type": "number"
            }
          },
          "required": [
            "y_from_end_um"
          ],
          "additionalProperties": false
        }
      ]
    },
    "LayoutConstraint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "length"
            },
            "instance": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
            },
            "value_um": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tolerance_um": {
              "default": 0.001,
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "instance",
            "value_um"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "length_difference"
            },
            "a": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
            },
            "b": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\/[A-Za-z][A-Za-z0-9_]*)*$"
            },
            "value_um": {
              "type": "number"
            },
            "tolerance_um": {
              "default": 0.002,
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "a",
            "b",
            "value_um"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
