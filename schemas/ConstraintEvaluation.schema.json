{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ConstraintEvaluation",
  "$defs": {
    "ConstraintEvaluation": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_evaluated"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "status",
        "value",
        "evidence_ids",
        "detail"
      ],
      "additionalProperties": false
    }
  }
}
