{
  "$defs": {
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/Endpoint"
        },
        "b": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "title": "Connection",
      "type": "object"
    },
    "DesignSpec": {
      "additionalProperties": false,
      "properties": {
        "delta_length_um": {
          "default": 10,
          "maximum": 200,
          "minimum": -200,
          "title": "Delta Length Um",
          "type": "number"
        },
        "device": {
          "const": "mzi",
          "default": "mzi",
          "title": "Device",
          "type": "string"
        },
        "outputs": {
          "items": {
            "enum": [
              "netlist",
              "simulation",
              "gds",
              "verification"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "platform": {
          "const": "sin",
          "default": "sin",
          "title": "Platform",
          "type": "string"
        },
        "sweep_points": {
          "default": 201,
          "maximum": 2001,
          "minimum": 3,
          "title": "Sweep Points",
          "type": "integer"
        },
        "sweep_span_nm": {
          "default": 40,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Sweep Span Nm",
          "type": "number"
        },
        "wavelength_nm": {
          "default": 1550,
          "maximum": 1600,
          "minimum": 1500,
          "title": "Wavelength Nm",
          "type": "number"
        }
      },
      "title": "DesignSpec",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "instance": {
          "title": "Instance",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "string"
        }
      },
      "required": [
        "instance",
        "port"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "InstanceIR": {
      "additionalProperties": false,
      "properties": {
        "coupling_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coupling Ratio"
        },
        "kind": {
          "enum": [
            "ideal_coupler",
            "waveguide"
          ],
          "title": "Kind",
          "type": "string"
        },
        "length_um": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Um"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ports": {
          "items": {
            "type": "string"
          },
          "title": "Ports",
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind",
        "ports"
      ],
      "title": "InstanceIR",
      "type": "object"
    },
    "NetlistIR": {
      "additionalProperties": false,
      "properties": {
        "connections": {
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "title": "Connections",
          "type": "array"
        },
        "instances": {
          "items": {
            "$ref": "#/$defs/InstanceIR"
          },
          "title": "Instances",
          "type": "array"
        },
        "ports": {
          "additionalProperties": {
            "$ref": "#/$defs/Endpoint"
          },
          "title": "Ports",
          "type": "object"
        }
      },
      "required": [
        "instances",
        "connections",
        "ports"
      ],
      "title": "NetlistIR",
      "type": "object"
    },
    "TaskIR": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "depends_on",
        "backend"
      ],
      "title": "TaskIR",
      "type": "object"
    },
    "TechnologyIR": {
      "additionalProperties": false,
      "properties": {
        "bend_radius_um": {
          "default": 50.0,
          "title": "Bend Radius Um",
          "type": "number"
        },
        "calibrated": {
          "const": false,
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        },
        "core_layer": {
          "default": [
            1,
            0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Core Layer",
          "type": "array"
        },
        "effective_index": {
          "default": 1.8,
          "title": "Effective Index",
          "type": "number"
        },
        "foundry": {
          "default": null,
          "title": "Foundry",
          "type": "null"
        },
        "group_index": {
          "default": 1.9,
          "title": "Group Index",
          "type": "number"
        },
        "loss_db_per_cm": {
          "default": 0.0,
          "title": "Loss Db Per Cm",
          "type": "number"
        },
        "minimum_spacing_um": {
          "default": 0.5,
          "title": "Minimum Spacing Um",
          "type": "number"
        },
        "minimum_width_um": {
          "default": 0.5,
          "title": "Minimum Width Um",
          "type": "number"
        },
        "model_version": {
          "const": "ideal_sin_v1",
          "default": "ideal_sin_v1",
          "title": "Model Version",
          "type": "string"
        },
        "name": {
          "const": "sin_demo_v1",
          "default": "sin_demo_v1",
          "title": "Name",
          "type": "string"
        },
        "reference_wavelength_um": {
          "default": 1.55,
          "title": "Reference Wavelength Um",
          "type": "number"
        },
        "thickness_um": {
          "default": 0.4,
          "title": "Thickness Um",
          "type": "number"
        },
        "width_um": {
          "default": 1.0,
          "title": "Width Um",
          "type": "number"
        }
      },
      "title": "TechnologyIR",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "design_id": {
      "title": "Design Id",
      "type": "string"
    },
    "layout_resolved": {
      "default": false,
      "title": "Layout Resolved",
      "type": "boolean"
    },
    "netlist": {
      "$ref": "#/$defs/NetlistIR"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "specification": {
      "$ref": "#/$defs/DesignSpec"
    },
    "technology": {
      "$ref": "#/$defs/TechnologyIR"
    },
    "workflow": {
      "items": {
        "$ref": "#/$defs/TaskIR"
      },
      "title": "Workflow",
      "type": "array"
    }
  },
  "required": [
    "design_id",
    "specification",
    "technology",
    "netlist",
    "workflow",
    "assumptions"
  ],
  "title": "EngineeringIR",
  "type": "object"
}
