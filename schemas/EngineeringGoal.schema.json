{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EngineeringGoal",
  "$defs": {
    "EngineeringGoal": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "type": "string",
          "const": "1.0"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/PhysicalModel"
        },
        "wavelength": {
          "$ref": "#/$defs/Length"
        },
        "polarization": {
          "type": "string",
          "enum": [
            "TE",
            "TM"
          ]
        },
        "numerical": {
          "type": "object",
          "properties": {
            "grid_step": {
              "$ref": "#/$defs/Length"
            },
            "padding": {
              "$ref": "#/$defs/Length"
            },
            "max_points": {
              "default": 12000,
              "type": "integer",
              "minimum": 64,
              "maximum": 20000
            }
          },
          "required": [
            "grid_step",
            "padding"
          ],
          "additionalProperties": false
        },
        "experiment_budget": {
          "default": 8,
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "reasoning_proposals": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReasoningProposal"
          }
        }
      },
      "required": [
        "goal",
        "capability_id",
        "model",
        "wavelength",
        "polarization",
        "numerical"
      ],
      "additionalProperties": false
    },
    "PhysicalModel": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "materials": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "refractive_index": {
                "type": "number"
              }
            },
            "required": [
              "refractive_index"
            ],
            "additionalProperties": false
          }
        },
        "layers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material": {
                "type": "string"
              },
              "thickness": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "material",
              "thickness"
            ],
            "additionalProperties": false
          }
        },
        "background_material": {
          "type": "string"
        },
        "assumptions": {
          "type": "object",
          "properties": {
            "linear": {
              "type": "boolean"
            },
            "lossless": {
              "type": "boolean"
            },
            "isotropic": {
              "type": "boolean"
            },
            "nonmagnetic": {
              "type": "boolean"
            },
            "propagation_invariant": {
              "type": "boolean"
            }
          },
          "required": [
            "linear",
            "lossless",
            "isotropic",
            "nonmagnetic",
            "propagation_invariant"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "materials",
        "layers",
        "background_material",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "Length": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "nm",
            "um",
            "m"
          ]
        },
        "dimension": {
          "default": "length",
          "type": "string",
          "const": "length"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "ReasoningProposal": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "const": "external_llm"
        },
        "claim": {
          "type": "string"
        },
        "cause": {
          "type": "string",
          "enum": [
            "discretization_error",
            "boundary_truncation",
            "non_reproducibility",
            "reference_disagreement",
            "input_error"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "claim",
        "cause",
        "rationale"
      ],
      "additionalProperties": false
    }
  }
}
